{
    # Global options
    # SSL/TLS ditangani oleh Cloudflare Edge & Cloudflare Tunnel
    auto_https off
}

# ─────────────────────────────────────────────────────────────
# 1. KEAMANAN: BLOKIR SEMUA AKSES LANGSUNG MENGGUNAKAN IP
#    (Contoh: http://172.125.x.x atau http://<IP_PUBLIK>)
# ─────────────────────────────────────────────────────────────
:80 {
    respond "403 Forbidden: Akses langsung via IP ({host}) diblokir! Seluruh akses wajib melalui domain resmi Cloudflare Tunnel." 403 {
        close
    }
}

# ─────────────────────────────────────────────────────────────
# 2. HANYA MENERIMA REQUEST DARI DOMAIN RESMI CLOUDFLARE
# ─────────────────────────────────────────────────────────────
http://{$DOMAIN_NAME} {
    # Rute ke Frontend (Next.js)
    reverse_proxy frontend:3001
}

http://api.{$DOMAIN_NAME} {
    # Rute ke Backend (Express.js)
    # lb_try_duration: Caddy akan retry koneksi ke backend selama 10 detik
    # sebelum menyerah dan mengembalikan 502. Ini mencegah 502 sesaat saat backend restart.
    reverse_proxy backend:3000 {
        lb_try_duration 10s
        lb_try_interval 500ms
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

http://storage.{$DOMAIN_NAME} {
    # Rute ke MinIO (Gambar & File)
    reverse_proxy minio:9000
}

http://stream.{$DOMAIN_NAME} {
    # Rute ke MediaMTX WHEP (Live Streaming) & HLS
    # Ini menyelesaikan masalah "Mixed Content" karena sekarang streaming memiliki HTTPS dari Cloudflare
    
    @options {
        method OPTIONS
    }
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS, PATCH, PUT, DELETE"
        header Access-Control-Allow-Headers "*"
        header Access-Control-Max-Age "3600"
        respond "" 204
    }

    # WHEP WebRTC signaling endpoint (e.g. /camera-id/whep)
    @whep path */whep
    handle @whep {
        reverse_proxy mediamtx:8889
    }

    # HLS fallback and static stream playback (e.g. /camera-id/index.m3u8)
    handle {
        reverse_proxy mediamtx:8888
    }
}
