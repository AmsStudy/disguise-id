{
    # Global options
    # Karena kita berada di belakang Cloudflare Proxy (yang sudah menyediakan HTTPS ke pengunjung),
    # Caddy bisa fokus ke HTTP biasa, atau Cloudflare Flexible SSL.
    # Namun untuk keamanan terbaik, kita biarkan Caddy memproses auto-HTTPS jika tidak bentrok,
    # atau cukup dengarkan HTTP/80 yang Cloudflare Proxy lewati.
    auto_https off
}

http://{$DOMAIN_NAME} {
    # Rute ke Frontend (Next.js)
    reverse_proxy frontend:3001
}

http://api.{$DOMAIN_NAME} {
    # Rute ke Backend (Express.js)
    # lb_try_duration: Caddy akan retry koneksi ke backend selama 10 detik
    # sebelum menyerah dan mengembalikan 502. Ini mencegah 502 sesaat saat backend restart.
    reverse_proxy backend:3000 {
        lb_try_duration 10s
        lb_try_interval 500ms
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

http://storage.{$DOMAIN_NAME} {
    # Rute ke MinIO (Gambar & File)
    reverse_proxy minio:9000
}

http://stream.{$DOMAIN_NAME} {
    # Rute ke MediaMTX WHEP (Live Streaming)
    # Ini menyelesaikan masalah "Mixed Content" karena sekarang streaming memiliki HTTPS dari Cloudflare
    
    @options {
        method OPTIONS
    }
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS, PATCH, PUT, DELETE"
        header Access-Control-Allow-Headers "*"
        header Access-Control-Max-Age "3600"
        respond "" 204
    }

    reverse_proxy mediamtx:8889
}
