# -----------------------------------------------------------------------------
# DISGUISE-ID - PRODUCTION CONFIGURATION (v2.1.0)
# -----------------------------------------------------------------------------
# Salin file ini menjadi `.env` di root direktori sebelum menjalankan docker compose.
# File `.env` sudah masuk dalam .gitignore dan tidak akan ter-commit ke git.

# =============================================================================
# 1. CLOUDFLARE TUNNEL & DOMAIN (Mencegah Akses Direct IP / Local Subnet)
# =============================================================================
# Domain utama (contoh: disguise.id)
DOMAIN_NAME=disguise.id

# TOKEN CLOUDFLARE TUNNEL (Zero Trust):
# Dapatkan dari Cloudflare Dashboard -> Zero Trust -> Networks -> Tunnels
# Masukkan token tunnel di sini. Layanan `cloudflared` pada Docker akan otomatis
# membuat tunnel keluar terenkripsi ke Cloudflare tanpa membuka port masuk ke host!
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...GANTI_DENGAN_TOKEN_CLOUDFLARE_TUNNEL...

# URL Publik Aplikasi (Wajib menggunakan domain HTTPS Cloudflare):
NEXT_PUBLIC_API_URL=https://api.disguise.id
NEXT_PUBLIC_WS_URL=wss://api.disguise.id
NEXT_PUBLIC_MEDIAMTX_WHEP_BASE_URL=https://stream.disguise.id

# Port Internal Backend (Diikat ke loopback 127.0.0.1)
BACKEND_PORT=3002

# =============================================================================
# 2. DATABASE (PostgreSQL 16 + pgvector)
# =============================================================================
# Ganti dengan password yang kuat dan unik!
DB_PASSWORD=GantiDenganPasswordSuperKuat123!
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/disguiseid

# =============================================================================
# 3. PENYIMPANAN OBJEK (MinIO S3)
# =============================================================================
MINIO_ROOT_USER=disguiseadmin
MINIO_ROOT_PASSWORD=GantiDenganMinioPasswordKuat!
# Domain publik MinIO (melalui Cloudflare Tunnel / Caddy)
MINIO_PUBLIC_URL=https://storage.disguise.id

# =============================================================================
# 4. KEAMANAN & ENKRIPSI KREDENSIAL
# =============================================================================
# JWT Secret untuk token otentikasi (generate: openssl rand -base64 32)
JWT_SECRET=GantiDenganSecretKeyJWTYangSangatPanjangDanAman123!

# Kunci Enkripsi AES-256 untuk kredensial kamera CCTV (32 bytes base64)
CAMERA_CREDENTIAL_KEY_VERSION=v1
CAMERA_CREDENTIAL_KEY_BASE64=ISzqe6KmlEjDs/nSiKl4us1y8PdGyy5zhyUAIWZdebY=

# =============================================================================
# 5. ML SERVICE V2 (GSIVAE + ArcFace v2.1)
# =============================================================================
ML_SERVICE_API_KEY=WalMWH1hinTEutYiOoeVeH8NYG-9d0P8DunLSlwYzGtgSCabPbN-bfQlQmBDtgec
