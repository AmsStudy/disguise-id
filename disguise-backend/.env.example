# Environment variables for DISGUISE-ID backend
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/disguiseid
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=disgid:

# ─────────────────────────────────────────────
# MinIO / Object Storage
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_FRAMES=cctv-frames
MINIO_BUCKET_FACES=face-crops
MINIO_BUCKET_WATCHLIST=watchlist-photos
MINIO_BUCKET_MODELS=ml-models
MINIO_PUBLIC_URL=http://localhost:9000

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-string-for-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret-string
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# ML Service (Python/FastAPI)
# ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=internal-api-key

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CAMERA_MAX=30

# ─────────────────────────────────────────────
# Retention
# ─────────────────────────────────────────────
RETENTION_FRAMES_DAYS=30
RETENTION_EVENTS_DAYS=365
  
ML_SERVICE_V2_ENABLED=false  
ML_SERVICE_V2_SHADOW_MODE=true  
ML_SERVICE_V2_URL=http://127.0.0.1:8001  
ML_SERVICE_V2_API_KEY=  
ML_SERVICE_V2_TIMEOUT_MS=30000  
ML_SERVICE_V2_FAIL_JOB=false  
ML_SERVICE_V2_SHADOW_LOG_PATH=logs/ml-v2-shadow.jsonl 

# ML Service V2 Persistence
ML_SERVICE_V2_PERSISTENCE_ENABLED=false
ML_SERVICE_V2_PERSISTENCE_FAIL_JOB=false
