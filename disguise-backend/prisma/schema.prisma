// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

enum MlV2ReviewStatus {
  PENDING
  COMPLETED
}

enum MlV2ReviewDecision {
  CONFIRMED
  REJECTED
  INCONCLUSIVE
}

enum MlV2GalleryCandidateStatus {
  ACTIVE
  INACTIVE
  TOMBSTONED
}

enum MlV2GalleryVersionStatus {
  BUILDING
  VALIDATED
  READY
  ACTIVE
  FAILED
  RETIRED
}

enum MlV2CandidateMappingStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────
// Organizations — multi-tenant root entity
// ─────────────────────────────────────────────────────────────
model Organization {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(255)
  code      String    @unique @db.VarChar(50)
  plan      String    @default("basic") @db.VarChar(50)
  settings  Json      @default("{}")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  users                  User[]
  cctvSources            CctvSource[]
  watchlistPersons       WatchlistPerson[]
  detectionEvents        DetectionEvent[]
  alerts                 Alert[]
  cases                  Case[]
  auditLogs              AuditLog[]
  mlV2OperatorReviews    MlV2OperatorReview[]
  mlV2ReviewedPromotions MlV2ReviewedPromotion[]
  mlV2ReviewedAlerts     MlV2ReviewedAlert[]
  mlV2GalleryCandidates  MlV2GalleryCandidate[]
  mlV2GalleryVersions    MlV2GalleryVersion[]
  mlV2CandidateMappings  MlV2CandidateMapping[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────
model User {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(255)
  role           String    @db.VarChar(50) // super_admin | admin | operator | investigator
  avatarUrl      String?   @map("avatar_url")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz()
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  organization               Organization            @relation(fields: [organizationId], references: [id])
  watchlistPersons           WatchlistPerson[]       @relation("AddedByUser")
  watchlistPhotos            WatchlistPhoto[]        @relation("UploadedByUser")
  assignedAlerts             Alert[]                 @relation("AssignedAlerts")
  reviewedAlerts             Alert[]                 @relation("ReviewedAlerts")
  caseLeads                  Case[]                  @relation("CaseLeadInvestigator")
  casesCreated               Case[]                  @relation("CasesCreatedBy")
  caseAlertsAdded            CaseAlert[]
  caseNotes                  CaseNote[]
  auditLogs                  AuditLog[]
  mlV2OperatorReviews        MlV2OperatorReview[]
  mlV2PromotionsCreated      MlV2ReviewedPromotion[]
  mlV2ReviewedAlertsCreated  MlV2ReviewedAlert[]     @relation("MlV2ReviewedAlertCreator")
  mlV2GalleryVersionsCreated MlV2GalleryVersion[]    @relation("GalleryVersionCreator")
  mlV2MappingsProposed       MlV2CandidateMapping[]  @relation("MappingProposer")
  mlV2MappingsApproved       MlV2CandidateMapping[]  @relation("MappingApprover")
  mlV2MappingsRejected       MlV2CandidateMapping[]  @relation("MappingRejector")
  mlV2MappingsRevoked        MlV2CandidateMapping[]  @relation("MappingRevoker")

  @@index([organizationId], name: "idx_users_org")
  @@index([email], name: "idx_users_email")
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// CCTV Sources (cameras)
// ─────────────────────────────────────────────────────────────
model CctvSource {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(255)
  locationName   String?   @map("location_name") @db.VarChar(255)
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  streamUrl      String?   @map("stream_url")
  ipAddress      String?   @map("ip_address") @db.VarChar(255)
  username       String?   @db.VarChar(255)
  password       String?   @db.VarChar(255)
  apiKeyHash     String?   @map("api_key_hash") @db.VarChar(255)
  modelVersion   String    @default("v1") @map("model_version") @db.VarChar(50)
  threshold      Decimal   @default(0.570) @db.Decimal(4, 3)
  status         String    @default("offline") @db.VarChar(50) // online | offline | error
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz()
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  organization    Organization     @relation(fields: [organizationId], references: [id])
  detectionEvents DetectionEvent[]

  @@index([organizationId], name: "idx_cctv_org")
  @@map("cctv_sources")
}

// ─────────────────────────────────────────────────────────────
// Watchlist Persons
// ─────────────────────────────────────────────────────────────
model WatchlistPerson {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  fullName       String    @map("full_name") @db.VarChar(255)
  alias          String[]
  idNumber       String?   @map("id_number") @db.VarChar(100)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String?   @db.VarChar(20)
  nationality    String?   @default("Indonesia") @db.VarChar(100)
  description    String?
  dangerLevel    String    @default("medium") @map("danger_level") @db.VarChar(50)
  caseReference  String?   @map("case_reference") @db.VarChar(255)
  photoUrl       String?   @map("photo_url")
  // Note: embedding (vector) managed via raw SQL / Prisma extensions
  embeddingModel String    @default("v1") @map("embedding_model") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  addedBy        String?   @map("added_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  organization         Organization           @relation(fields: [organizationId], references: [id])
  addedByUser          User?                  @relation("AddedByUser", fields: [addedBy], references: [id])
  photos               WatchlistPhoto[]
  detectionEvents      DetectionEvent[]       @relation("BestMatchPerson")
  alerts               Alert[]
  MlV2CandidateMapping MlV2CandidateMapping[]

  @@index([organizationId], name: "idx_watchlist_org")
  @@map("watchlist_persons")
}

// ─────────────────────────────────────────────────────────────
// Watchlist Photos
// ─────────────────────────────────────────────────────────────
model WatchlistPhoto {
  id             String    @id @default(uuid())
  personId       String    @map("person_id")
  photoUrl       String    @map("photo_url")
  embeddingModel String    @default("v1") @map("embedding_model") @db.VarChar(50)
  isPrimary      Boolean   @default(false) @map("is_primary")
  source         String?   @db.VarChar(100)
  capturedAt     DateTime? @map("captured_at") @db.Timestamptz()
  uploadedBy     String?   @map("uploaded_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  person         WatchlistPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  uploadedByUser User?           @relation("UploadedByUser", fields: [uploadedBy], references: [id])

  @@index([personId], name: "idx_photos_person")
  @@map("watchlist_photos")
}

// ─────────────────────────────────────────────────────────────
// Detection Events
// ─────────────────────────────────────────────────────────────
model DetectionEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sourceId       String   @map("source_id")
  frameUrl       String?  @map("frame_url")
  faceCropUrl    String?  @map("face_crop_url")
  // embedding stored via raw SQL
  bestMatchId    String?  @map("best_match_id")
  bestMatchSim   Decimal? @map("best_match_sim") @db.Decimal(6, 5)
  isMatch        Boolean  @default(false) @map("is_match")
  processingMs   Int?     @map("processing_ms")
  modelVersion   String   @default("v1") @map("model_version") @db.VarChar(50)
  metadata       Json     @default("{}")
  detectedAt     DateTime @default(now()) @map("detected_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization       Organization         @relation(fields: [organizationId], references: [id])
  source             CctvSource           @relation(fields: [sourceId], references: [id])
  bestMatch          WatchlistPerson?     @relation("BestMatchPerson", fields: [bestMatchId], references: [id])
  alerts             Alert[]
  mlV2Result         MlV2InferenceResult?
  mlV2ReviewedAlerts MlV2ReviewedAlert[]

  @@index([organizationId], name: "idx_events_org_date")
  @@index([sourceId], name: "idx_events_source")
  @@index([bestMatchId], name: "idx_events_match")
  @@map("detection_events")
}

// ─────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────
model Alert {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  detectionEventId String    @map("detection_event_id")
  personId         String    @map("person_id")
  similarityScore  Decimal   @map("similarity_score") @db.Decimal(6, 5)
  status           String    @default("pending") @db.VarChar(50) // pending | confirmed | dismissed | false_positive
  priority         String    @default("medium") @db.VarChar(50) // low | medium | high | critical
  assignedTo       String?   @map("assigned_to")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNotes      String?   @map("review_notes")
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  organization   Organization    @relation(fields: [organizationId], references: [id])
  detectionEvent DetectionEvent  @relation(fields: [detectionEventId], references: [id])
  person         WatchlistPerson @relation(fields: [personId], references: [id])
  assignedToUser User?           @relation("AssignedAlerts", fields: [assignedTo], references: [id])
  reviewedByUser User?           @relation("ReviewedAlerts", fields: [reviewedBy], references: [id])
  caseAlerts     CaseAlert[]

  @@index([organizationId], name: "idx_alerts_org_status")
  @@index([assignedTo], name: "idx_alerts_assigned")
  @@map("alerts")
}

// ─────────────────────────────────────────────────────────────
// Cases
// ─────────────────────────────────────────────────────────────
model Case {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  caseNumber         String    @unique @map("case_number") @db.VarChar(100)
  title              String    @db.VarChar(255)
  description        String?
  status             String    @default("open") @db.VarChar(50) // open | investigating | closed | archived
  priority           String    @default("medium") @db.VarChar(50)
  leadInvestigatorId String?   @map("lead_investigator_id")
  createdBy          String?   @map("created_by")
  closedAt           DateTime? @map("closed_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()

  organization     Organization @relation(fields: [organizationId], references: [id])
  leadInvestigator User?        @relation("CaseLeadInvestigator", fields: [leadInvestigatorId], references: [id])
  createdByUser    User?        @relation("CasesCreatedBy", fields: [createdBy], references: [id])
  caseAlerts       CaseAlert[]
  notes            CaseNote[]

  @@map("cases")
}

model CaseAlert {
  caseId  String   @map("case_id")
  alertId String   @map("alert_id")
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()
  addedBy String?  @map("added_by")

  case        Case  @relation(fields: [caseId], references: [id])
  alert       Alert @relation(fields: [alertId], references: [id])
  addedByUser User? @relation(fields: [addedBy], references: [id])

  @@id([caseId, alertId])
  @@map("case_alerts")
}

model CaseNote {
  id          String   @id @default(uuid())
  caseId      String   @map("case_id")
  content     String
  attachments Json     @default("[]")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  case          Case  @relation(fields: [caseId], references: [id])
  createdByUser User? @relation(fields: [createdBy], references: [id])

  @@map("case_notes")
}

// ─────────────────────────────────────────────────────────────
// Audit Logs — append only
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String   @db.VarChar(100)
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId], name: "idx_audit_org_date")
  @@index([userId], name: "idx_audit_user")
  @@map("audit_logs")
}

model MlV2InferenceResult {
  id               String  @id @default(uuid())
  detectionEventId String  @unique @map("detection_event_id")
  jobId            String? @map("job_id")
  requestId        String? @map("request_id")
  cameraSessionId  String? @map("camera_session_id")
  trackId          String? @map("track_id")

  status    String  @db.VarChar(50)
  errorCode String? @map("error_code") @db.VarChar(50)

  modelVersion   String? @map("model_version") @db.VarChar(50)
  galleryVersion String? @map("gallery_version") @db.VarChar(100)

  originalValid       Boolean? @map("original_valid")
  originalCandidateId String?  @map("original_candidate_id")
  originalScore       Float?   @map("original_score")
  originalSecondScore Float?   @map("original_second_score")
  originalMargin      Float?   @map("original_margin")

  reconstructedValid       Boolean? @map("reconstructed_valid")
  reconstructedCandidateId String?  @map("reconstructed_candidate_id")
  reconstructedScore       Float?   @map("reconstructed_score")
  reconstructedSecondScore Float?   @map("reconstructed_second_score")
  reconstructedMargin      Float?   @map("reconstructed_margin")

  selectedBranch String? @map("selected_branch") @db.VarChar(50)
  candidateId    String? @map("candidate_id")
  score          Float?
  margin         Float?
  frameDecision  String? @map("frame_decision") @db.VarChar(100)

  serviceProcessingMs          Int?    @map("service_processing_ms")
  roundTripLatencyMs           Int?    @map("round_trip_latency_ms")
  requiresOperatorVerification Boolean @default(false) @map("requires_operator_verification")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  detectionEvent DetectionEvent      @relation(fields: [detectionEventId], references: [id], onDelete: Cascade)
  operatorReview MlV2OperatorReview?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([frameDecision, createdAt])
  @@map("ml_v2_inference_results")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Operator Review
// ─────────────────────────────────────────────────────────────
model MlV2OperatorReview {
  id                String  @id @default(uuid())
  inferenceResultId String  @unique @map("inference_result_id")
  organizationId    String  @map("organization_id")
  reviewerId        String? @map("reviewer_id")

  status              MlV2ReviewStatus    @default(PENDING)
  decision            MlV2ReviewDecision?
  reviewedCandidateId String?             @map("reviewed_candidate_id")
  notes               String?             @db.Text

  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz()
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  inferenceResult MlV2InferenceResult    @relation(fields: [inferenceResultId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id])
  reviewer        User?                  @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  promotion       MlV2ReviewedPromotion?

  @@index([organizationId, status, createdAt], name: "idx_v2_review_org_status")
  @@index([reviewerId, status, createdAt], name: "idx_v2_review_reviewer_status")
  @@map("ml_v2_operator_reviews")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Reviewed Promotion (Phase 3E)
// ─────────────────────────────────────────────────────────────
model MlV2ReviewedPromotion {
  id             String @id @default(uuid())
  reviewId       String @unique @map("review_id")
  organizationId String @map("organization_id")
  promotedById   String @map("promoted_by_id")

  promotedCandidateId String  @map("promoted_candidate_id")
  notes               String? @db.Text

  promotedAt DateTime @default(now()) @map("promoted_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  review        MlV2OperatorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id])
  promotedBy    User               @relation(fields: [promotedById], references: [id])
  reviewedAlert MlV2ReviewedAlert?

  @@index([organizationId, promotedAt], name: "idx_v2_promotion_org")
  @@index([promotedById, promotedAt], name: "idx_v2_promotion_user")
  @@index([promotedCandidateId, promotedAt], name: "idx_v2_promotion_candidate")
  @@map("ml_v2_reviewed_promotions")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Reviewed Alert (Phase 3F)
// ─────────────────────────────────────────────────────────────
model MlV2ReviewedAlert {
  id               String @id @default(uuid())
  promotionId      String @unique @map("promotion_id")
  organizationId   String @map("organization_id")
  detectionEventId String @map("detection_event_id")
  createdById      String @map("created_by_id")

  promotedCandidateId String  @map("promoted_candidate_id")
  title               String
  notes               String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  promotion      MlV2ReviewedPromotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  detectionEvent DetectionEvent        @relation(fields: [detectionEventId], references: [id], onDelete: Restrict)
  createdBy      User                  @relation("MlV2ReviewedAlertCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt], name: "idx_v2_reviewed_alert_org")
  @@index([detectionEventId, createdAt], name: "idx_v2_reviewed_alert_event")
  @@index([promotedCandidateId, createdAt], name: "idx_v2_reviewed_alert_candidate")
  @@map("ml_v2_reviewed_alerts")
}

// ─────────────────────────────────────────────────────────────
// Model Versions — ML model tracking
// ─────────────────────────────────────────────────────────────
model ModelVersion {
  id          String    @id @default(uuid())
  version     String    @unique @db.VarChar(50)
  description String?
  modelPath   String    @map("model_path")
  threshold   Decimal   @db.Decimal(4, 3)
  rocAuc      Decimal?  @map("roc_auc") @db.Decimal(6, 5)
  tpr         Decimal?  @db.Decimal(6, 5)
  fpr         Decimal?  @db.Decimal(6, 5)
  accuracy    Decimal?  @db.Decimal(6, 5)
  isActive    Boolean   @default(false) @map("is_active")
  deployedAt  DateTime? @map("deployed_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@map("model_versions")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Gallery Candidate (Phase 5C)
// ─────────────────────────────────────────────────────────────
model MlV2GalleryCandidate {
  id                 String                     @id @default(uuid())
  organizationId     String                     @map("organization_id")
  galleryCandidateId String                     @unique @default(uuid()) @map("gallery_candidate_id")
  sourcePersonId     String?                    @map("source_person_id")
  status             MlV2GalleryCandidateStatus
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  deactivatedAt      DateTime?                  @map("deactivated_at") @db.Timestamptz()

  organization Organization                  @relation(fields: [organizationId], references: [id])
  versions     MlV2GalleryVersionCandidate[]

  @@unique([organizationId, galleryCandidateId], name: "idx_v2_gallery_candidate_org_id")
  @@map("ml_v2_gallery_candidates")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Gallery Version (Phase 5C)
// ─────────────────────────────────────────────────────────────
model MlV2GalleryVersion {
  id                   String                   @id @default(uuid())
  organizationId       String                   @map("organization_id")
  version              String                   @db.VarChar(100)
  checksum             String                   @db.VarChar(100)
  modelVersion         String                   @map("model_version") @db.VarChar(50)
  preprocessingVersion String                   @map("preprocessing_version") @db.VarChar(50)
  status               MlV2GalleryVersionStatus
  parentVersionId      String?                  @map("parent_version_id")
  createdById          String?                  @map("created_by_id")
  activatedAt          DateTime?                @map("activated_at") @db.Timestamptz()
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization                  @relation(fields: [organizationId], references: [id])
  createdBy    User?                         @relation("GalleryVersionCreator", fields: [createdById], references: [id])
  candidates   MlV2GalleryVersionCandidate[]

  @@unique([organizationId, version], name: "idx_v2_gallery_version_org_version")
  @@map("ml_v2_gallery_versions")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Gallery Version Candidate (Phase 5C)
// ─────────────────────────────────────────────────────────────
model MlV2GalleryVersionCandidate {
  id                   String  @id @default(uuid())
  galleryVersionId     String  @map("gallery_version_id")
  galleryCandidateId   String  @map("gallery_candidate_id") // Relates to MlV2GalleryCandidate.galleryCandidateId
  sourceObjectKey      String  @map("source_object_key")
  sourceChecksum       String  @map("source_checksum")
  embeddingArtifactKey String? @map("embedding_artifact_key")

  galleryVersion MlV2GalleryVersion   @relation(fields: [galleryVersionId], references: [id], onDelete: Cascade)
  candidate      MlV2GalleryCandidate @relation(fields: [galleryCandidateId], references: [galleryCandidateId])

  @@unique([galleryVersionId, galleryCandidateId], name: "idx_v2_version_candidate_unique")
  @@map("ml_v2_gallery_version_candidates")
}

// ─────────────────────────────────────────────────────────────
// ML V2 Candidate Mapping (Phase 5C)
// ─────────────────────────────────────────────────────────────
model MlV2CandidateMapping {
  id                 String                     @id @default(uuid())
  organizationId     String                     @map("organization_id")
  galleryCandidateId String                     @map("gallery_candidate_id")
  watchlistPersonId  String                     @map("watchlist_person_id")
  status             MlV2CandidateMappingStatus @default(PENDING)
  proposedById       String                     @map("proposed_by_id")
  approvedById       String?                    @map("approved_by_id")
  proposalReason     String?                    @map("proposal_reason") @db.Text
  proposedAt         DateTime                   @default(now()) @map("proposed_at") @db.Timestamptz()
  approvedAt         DateTime?                  @map("approved_at") @db.Timestamptz()
  rejectedById       String?                    @map("rejected_by_id")
  rejectedAt         DateTime?                  @map("rejected_at") @db.Timestamptz()
  rejectionReason    String?                    @map("rejection_reason") @db.Text
  revokedById        String?                    @map("revoked_by_id")
  revokedAt          DateTime?                  @map("revoked_at") @db.Timestamptz()
  revocationReason   String?                    @map("revocation_reason") @db.Text

  organization    Organization    @relation(fields: [organizationId], references: [id])
  watchlistPerson WatchlistPerson @relation(fields: [watchlistPersonId], references: [id], onDelete: Restrict)
  proposedBy      User            @relation("MappingProposer", fields: [proposedById], references: [id])
  approvedBy      User?           @relation("MappingApprover", fields: [approvedById], references: [id])
  rejectedBy      User?           @relation("MappingRejector", fields: [rejectedById], references: [id])
  revokedBy       User?           @relation("MappingRevoker", fields: [revokedById], references: [id])

  // Optional: Enforce only one active mapping via application logic or partial unique index.
  // Prisma doesn't fully support WHERE clauses in @unique, so we'll rely on service logic.

  @@index([organizationId, galleryCandidateId, status], name: "idx_v2_mapping_org_candidate_status")
  @@map("ml_v2_candidate_mappings")
}
